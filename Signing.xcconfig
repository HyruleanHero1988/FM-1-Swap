// The Apple developer team that signs builds for a device or the Mac.
//
// Xcode forgets a team picked under Signing & Capabilities each time `xcodegen generate` rewrites
// the project, so set it in Signing.local.xcconfig next to this file instead. That file is
// git-ignored, as each developer has their own team. It holds one line:
//
//     DEVELOPMENT_TEAM = <your team ID>
//
// Without it, builds for the simulator and checks that skip signing still work.

#include? "Signing.local.xcconfig"
